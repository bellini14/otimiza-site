{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/verify-production-source.mjs && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/post-page.js": { "includeFiles": "dist/post-shell.html" }
  },
  "redirects": [
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug/index.html",
      "destination": "/:year/:month/:day/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Expose-Headers",
          "value": "Content-Encoding"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/quem-somos",
      "destination": "/quem-somos.html"
    },
    {
      "source": "/nossa-abordagem",
      "destination": "/nossa-abordagem.html"
    },
    {
      "source": "/o-que-fazemos",
      "destination": "/o-que-fazemos.html"
    },
    {
      "source": "/cases",
      "destination": "/cases.html"
    },
    {
      "source": "/tecnologia",
      "destination": "/tecnologia.html"
    },
    {
      "source": "/academia-otimiza",
      "destination": "/academia-otimiza.html"
    },
    {
      "source": "/contato",
      "destination": "/contato.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade.html"
    },
    {
      "source": "/inspire",
      "destination": "/inspire.html"
    },
    {
      "source": "/inspire/newsletter",
      "destination": "/inspire/newsletter.html"
    },
    {
      "source": "/inspire/newsletter/",
      "destination": "/inspire/newsletter.html"
    },
    {
      "source": "/silvana-bettiol",
      "destination": "/silvana-bettiol.html"
    },
    {
      "source": "/cases/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/inspire/:slug",
      "destination": "/api/post-page?slug=:slug"
    },
    {
      "source": "/inspire/:slug/",
      "destination": "/api/post-page?slug=:slug"
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/api/post-page?slug=:slug&date=:year/:month/:day"
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug/",
      "destination": "/api/post-page?slug=:slug&date=:year/:month/:day"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
