SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=mailerotm
SMTP_PASS=replace-with-the-smtp-password
CONTACT_FROM_EMAIL=site@otm.com.br
CONTACT_TO_EMAIL=otm@otm.com.br
NEWSLETTER_TO_EMAIL=otm@otm.com.br
VITE_SITE_URL=https://www.otm.com.br

SILVANA_INVITEES_JSON=[{"email":"convidada@example.com","name":"Convidada Exemplo"}]
SILVANA_EMAIL_KEY_SECRET=replace-with-a-long-random-secret
SILVANA_SESSION_SECRET=replace-with-a-different-long-random-secret
