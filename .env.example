VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=otm.com.br,www.otm.com.br
# Reutiliza POSTGRES_URL ou DATABASE_URL, somente no servidor.
